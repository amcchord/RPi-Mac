 }
 
+static float web_tablet_guest_x = -1.0f;
+static float web_tablet_guest_y = -1.0f;
+
+static float web_tablet_axis_max(bool vertical)
+{
+    if (vertical) {
+        if (mouse.max_y > 0) {
+            return (float)mouse.max_y;
+        }
+        if (mouse.max_screen_y > 0) {
+            return (float)mouse.max_screen_y;
+        }
+    } else {
+        if (mouse.max_x > 0) {
+            return (float)mouse.max_x;
+        }
+        if (mouse.max_screen_x > 0) {
+            return (float)mouse.max_screen_x;
+        }
+    }
+    return 0.0f;
+}
+
+static float web_tablet_host_to_guest(int host_pos, int host_size, float guest_max)
+{
+    if (host_size <= 1) {
+        return guest_max * 0.5f;
+    }
+    if (guest_max <= 0.0f) {
+        return (float)host_pos;
+    }
+    return ((float)host_pos * guest_max) / (float)(host_size - 1);
+}
+
+static void web_tablet_aux_motion(float dx, float dy)
+{
+    float rem_x = dx;
+    float rem_y = dy;
+    int guard = 0;
+
+    user_cursor_locked = true;
+    while ((rem_x > 0.01f || rem_x < -0.01f || rem_y > 0.01f || rem_y < -0.01f) && guard < 96) {
+        float step_x = rem_x;
+        float step_y = rem_y;
+        if (step_x > 2048.0f) {
+            step_x = 2048.0f;
+        }
+        if (step_x < -2048.0f) {
+            step_x = -2048.0f;
+        }
+        if (step_y > 2048.0f) {
+            step_y = 2048.0f;
+        }
+        if (step_y < -2048.0f) {
+            step_y = -2048.0f;
+        }
+        KEYBOARD_AUX_Event(step_x, step_y, mouse.buttons, mouse.scrollwheel);
+        rem_x -= step_x;
+        rem_y -= step_y;
+        guard++;
+    }
+    user_cursor_locked = false;
+}
+
+void Mouse_WebTabletReset(void)
+{
+    web_tablet_guest_x = -1.0f;
+    web_tablet_guest_y = -1.0f;
+}
+
+void Mouse_WebTabletMove(int host_x, int host_y, int host_w, int host_h)
+{
+    if (host_w <= 0 || host_h <= 0) {
+        return;
+    }
+
+    user_cursor_x = host_x;
+    user_cursor_y = host_y;
+    user_cursor_sw = host_w;
+    user_cursor_sh = host_h;
+    user_cursor_emulation = MOUSE_EMULATION_NEVER;
+    user_cursor_locked = false;
+
+    float guest_max_x = web_tablet_axis_max(false);
+    float guest_max_y = web_tablet_axis_max(true);
+    float target_x = web_tablet_host_to_guest(host_x, host_w, guest_max_x);
+    float target_y = web_tablet_host_to_guest(host_y, host_h, guest_max_y);
+
+    if (web_tablet_guest_x < 0.0f) {
+        web_tablet_guest_x = mouse.x;
+        web_tablet_guest_y = mouse.y;
+    }
+
+    float dx = target_x - web_tablet_guest_x;
+    float dy = target_y - web_tablet_guest_y;
+    web_tablet_guest_x = target_x;
+    web_tablet_guest_y = target_y;
+
+    if (dx == 0.0f && dy == 0.0f) {
+        return;
+    }
+
+    mouse.x = target_x;
+    mouse.y = target_y;
+    if (mouse.max_x > 0) {
+        if (mouse.x > mouse.max_x) {
+            mouse.x = (float)mouse.max_x;
+        }
+        if (mouse.x < mouse.min_x) {
+            mouse.x = (float)mouse.min_x;
+        }
+    }
+    if (mouse.max_y > 0) {
+        if (mouse.y > mouse.max_y) {
+            mouse.y = (float)mouse.max_y;
+        }
+        if (mouse.y < mouse.min_y) {
+            mouse.y = (float)mouse.min_y;
+        }
+    }
+
+    if (!IS_PC98_ARCH && KEYBOARD_AUX_Active()) {
+        web_tablet_aux_motion(dx, dy);
+    }
+
+    Mouse_AddEvent(MOUSE_HAS_MOVED);
+}
