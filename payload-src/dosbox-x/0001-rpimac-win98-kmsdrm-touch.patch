@@ -0,0 +1,639 @@
+/*
+ * Browser console support for the Win98 portable stack.
+ * Mirrors SDL surface pixels to /dev/shm/win98-screen and reads
+ * /dev/shm/win98-input for synthetic SDL events from the web UI.
+ */
+
+#if defined(__linux__)
+
+#include "config.h"
+#include "win98_web_console.h"
+
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <SDL.h>
+
+#include "keyboard.h"
+#include "mouse.h"
+#include "sdlmain.h"
+
+#define WIN98_SCREEN_MAGIC 0x57493832u
+#define WIN98_SCREEN_PATH "/dev/shm/win98-screen"
+#define WIN98_SCREEN_WANT "/dev/shm/win98-screen-want"
+#define WIN98_INPUT_PATH "/dev/shm/win98-input"
+
+enum {
+    WIN98_INPUT_MOUSE_MOVE = 1,
+    WIN98_INPUT_MOUSE_BUTTON = 2,
+    WIN98_INPUT_KEY = 3
+};
+
+struct Win98InputEvent {
+    uint32_t type;
+    int32_t x;
+    int32_t y;
+    uint32_t button;
+    uint32_t state;
+    uint32_t sym;
+};
+
+struct Win98InputQueue {
+    uint32_t write_idx;
+    uint32_t read_idx;
+    Win98InputEvent events[512];
+};
+
+static SDL_Rect dirty_acc = {0, 0, 0, 0};
+static uint32_t frame_seq = 0;
+
+static int screen_fd = -2;
+static uint8_t *screen_map = NULL;
+static size_t screen_map_size = 0;
+
+static int input_fd = -2;
+static struct Win98InputQueue *input_map = NULL;
+
+static bool viewer_wants_frames(void)
+{
+    struct stat want;
+    if (stat(WIN98_SCREEN_WANT, &want) != 0) {
+        return false;
+    }
+    time_t now = time(NULL);
+    if (now - want.st_mtime > 10) {
+        return false;
+    }
+    return true;
+}
+
+static void ensure_input_map(void)
+{
+    size_t need = sizeof(struct Win98InputQueue);
+    if (input_fd >= 0 && input_map != NULL) {
+        return;
+    }
+    if (input_fd == -2) {
+        input_fd = open(WIN98_INPUT_PATH, O_RDWR | O_CREAT, 0666);
+    }
+    if (input_fd < 0) {
+        input_fd = -2;
+        return;
+    }
+    struct stat st;
+    if (fstat(input_fd, &st) != 0) {
+        return;
+    }
+    if ((size_t)st.st_size != need) {
+        if (ftruncate(input_fd, (off_t)need) != 0) {
+            return;
+        }
+    }
+    void *mapped = mmap(NULL, need, PROT_READ | PROT_WRITE, MAP_SHARED, input_fd, 0);
+    if (mapped == MAP_FAILED) {
+        return;
+    }
+    input_map = (struct Win98InputQueue *)mapped;
+    if ((size_t)st.st_size != need) {
+        input_map->write_idx = 0;
+        input_map->read_idx = 0;
+    }
+}
+
+static void copy_guest_pixels(uint8_t *dst, SDL_Surface *surface, int guest_w, int guest_h, int clip_x, int clip_y)
+{
+    int src_bpp = surface->format->BytesPerPixel;
+    uint8_t *base = (uint8_t *)surface->pixels + clip_y * surface->pitch + clip_x * src_bpp;
+    SDL_PixelFormat *fmt = surface->format;
+
+    for (int row = 0; row < guest_h; row++) {
+        uint8_t *src_row = base + row * surface->pitch;
+        uint8_t *dst_row = dst + (size_t)row * (size_t)guest_w * 4u;
+        for (int col = 0; col < guest_w; col++) {
+            uint8_t *src_px = src_row + col * src_bpp;
+            uint32_t pixel = 0;
+            if (src_bpp == 4) {
+                pixel = *(uint32_t *)src_px;
+            } else if (src_bpp == 3) {
+                pixel = (uint32_t)src_px[0] | ((uint32_t)src_px[1] << 8) | ((uint32_t)src_px[2] << 16);
+            } else {
+                pixel = *(uint16_t *)src_px;
+            }
+            uint8_t r = 0;
+            uint8_t g = 0;
+            uint8_t b = 0;
+            SDL_GetRGB(pixel, fmt, &r, &g, &b);
+            size_t out = (size_t)col * 4u;
+            dst_row[out + 0] = r;
+            dst_row[out + 1] = g;
+            dst_row[out + 2] = b;
+            dst_row[out + 3] = 255;
+        }
+    }
+}
+
+void win98_web_console_publish_surface(SDL_Surface *surface, int guest_w, int guest_h, int clip_x, int clip_y)
+{
+    static uint32_t last_publish = 0;
+    uint32_t now = SDL_GetTicks();
+    if (surface == NULL || guest_w <= 0 || guest_h <= 0) {
+        return;
+    }
+    if (now - last_publish < 66) {
+        return;
+    }
+    if (!viewer_wants_frames()) {
+        return;
+    }
+
+    SDL_Rect full = {0, 0, guest_w, guest_h};
+    SDL_UnionRect(&dirty_acc, &full, &dirty_acc);
+    last_publish = now;
+
+    size_t frame_bytes = (size_t)guest_w * (size_t)guest_h * 4u;
+    size_t need = 80u + frame_bytes;
+    if (screen_fd >= 0) {
+        struct stat st;
+        if (stat(WIN98_SCREEN_PATH, &st) != 0) {
+            close(screen_fd);
+            screen_fd = -2;
+            if (screen_map != NULL) {
+                munmap(screen_map, screen_map_size);
+                screen_map = NULL;
+                screen_map_size = 0;
+            }
+        }
+    }
+    if (screen_fd == -2) {
+        screen_fd = open(WIN98_SCREEN_PATH, O_RDWR | O_CREAT, 0666);
+    }
+    if (screen_fd < 0) {
+        screen_fd = -2;
+        return;
+    }
+    if (screen_map_size != need) {
+        if (screen_map != NULL) {
+            munmap(screen_map, screen_map_size);
+            screen_map = NULL;
+            screen_map_size = 0;
+        }
+        if (ftruncate(screen_fd, (off_t)need) != 0) {
+            return;
+        }
+        void *mapped = mmap(NULL, need, PROT_READ | PROT_WRITE, MAP_SHARED, screen_fd, 0);
+        if (mapped == MAP_FAILED) {
+            return;
+        }
+        screen_map = (uint8_t *)mapped;
+        screen_map_size = need;
+    }
+
+    bool must_lock = SDL_MUSTLOCK(surface) != 0;
+    if (must_lock) {
+        if (SDL_LockSurface(surface) != 0) {
+            return;
+        }
+    }
+
+    copy_guest_pixels(screen_map + 80, surface, guest_w, guest_h, clip_x, clip_y);
+
+    if (must_lock) {
+        SDL_UnlockSurface(surface);
+    }
+
+    frame_seq++;
+    uint32_t *hdr = (uint32_t *)screen_map;
+    hdr[0] = WIN98_SCREEN_MAGIC;
+    hdr[1] = (uint32_t)guest_w;
+    hdr[2] = (uint32_t)guest_h;
+    hdr[3] = frame_seq;
+    hdr[4] = 0;
+    hdr[5] = 1;
+    hdr[6] = 2;
+    hdr[7] = 0;
+    hdr[8] = 0;
+    hdr[9] = 0;
+    hdr[10] = (uint32_t)guest_w;
+    hdr[11] = (uint32_t)guest_h;
+    hdr[12] = (uint32_t)clip_x;
+    hdr[13] = (uint32_t)clip_y;
+    hdr[14] = (uint32_t)guest_w;
+    hdr[15] = (uint32_t)guest_h;
+    hdr[16] = (uint32_t)surface->w;
+    hdr[17] = (uint32_t)surface->h;
+    hdr[18] = 0;
+    hdr[19] = 0;
+
+    dirty_acc.x = 0;
+    dirty_acc.y = 0;
+    dirty_acc.w = 0;
+    dirty_acc.h = 0;
+}
+
+void win98_web_console_publish_bgra(const unsigned char *src, int guest_w, int guest_h, int src_pitch)
+{
+    static uint32_t last_publish = 0;
+    uint32_t now = SDL_GetTicks();
+    if (src == NULL || guest_w <= 0 || guest_h <= 0 || src_pitch <= 0) {
+        return;
+    }
+    if (now - last_publish < 66) {
+        return;
+    }
+    if (!viewer_wants_frames()) {
+        return;
+    }
+    last_publish = now;
+
+    size_t frame_bytes = (size_t)guest_w * (size_t)guest_h * 4u;
+    size_t need = 80u + frame_bytes;
+    if (screen_fd >= 0) {
+        struct stat st;
+        if (stat(WIN98_SCREEN_PATH, &st) != 0) {
+            close(screen_fd);
+            screen_fd = -2;
+            if (screen_map != NULL) {
+                munmap(screen_map, screen_map_size);
+                screen_map = NULL;
+                screen_map_size = 0;
+            }
+        }
+    }
+    if (screen_fd == -2) {
+        screen_fd = open(WIN98_SCREEN_PATH, O_RDWR | O_CREAT, 0666);
+    }
+    if (screen_fd < 0) {
+        screen_fd = -2;
+        return;
+    }
+    if (screen_map_size != need) {
+        if (screen_map != NULL) {
+            munmap(screen_map, screen_map_size);
+            screen_map = NULL;
+            screen_map_size = 0;
+        }
+        if (ftruncate(screen_fd, (off_t)need) != 0) {
+            return;
+        }
+        void *mapped = mmap(NULL, need, PROT_READ | PROT_WRITE, MAP_SHARED, screen_fd, 0);
+        if (mapped == MAP_FAILED) {
+            return;
+        }
+        screen_map = (uint8_t *)mapped;
+        screen_map_size = need;
+    }
+
+    uint8_t *dst = screen_map + 80;
+    size_t dst_row_bytes = (size_t)guest_w * 4u;
+    for (int row = 0; row < guest_h; row++) {
+        memcpy(dst + (size_t)row * dst_row_bytes,
+               src + (size_t)row * (size_t)src_pitch,
+               dst_row_bytes);
+    }
+
+    frame_seq++;
+    uint32_t *hdr = (uint32_t *)screen_map;
+    hdr[0] = WIN98_SCREEN_MAGIC;
+    hdr[1] = (uint32_t)guest_w;
+    hdr[2] = (uint32_t)guest_h;
+    hdr[3] = frame_seq;
+    /* Framebuffer bytes are B,G,R,A in memory (GL_BGRA + 8_8_8_8_REV), so
+     * red is at byte 2, green at 1, blue at 0. */
+    hdr[4] = 2;
+    hdr[5] = 1;
+    hdr[6] = 0;
+    hdr[7] = 0;
+    /* Full-frame update each publish (no dirty-rect tracking for GL). */
+    hdr[8] = 0;
+    hdr[9] = 0;
+    hdr[10] = (uint32_t)guest_w;
+    hdr[11] = (uint32_t)guest_h;
+    hdr[12] = 0;
+    hdr[13] = 0;
+    hdr[14] = (uint32_t)guest_w;
+    hdr[15] = (uint32_t)guest_h;
+    hdr[16] = (uint32_t)guest_w;
+    hdr[17] = (uint32_t)guest_h;
+    hdr[18] = 0;
+    hdr[19] = 0;
+}
+
+static void push_mouse_motion(int x, int y)
+{
+    int host_w = (int)sdl.draw.width;
+    int host_h = (int)sdl.draw.height;
+    if (host_w <= 0) {
+        host_w = sdl.clip.w;
+    }
+    if (host_h <= 0) {
+        host_h = sdl.clip.h;
+    }
+    if (host_w <= 0 || host_h <= 0) {
+        return;
+    }
+    Mouse_WebTabletMove(x, y, host_w, host_h);
+}
+
+static void push_mouse_button(uint32_t button, uint32_t state, int x, int y)
+{
+    push_mouse_motion(x, y);
+
+    uint8_t btn = 0;
+    if (button == 2) {
+        btn = 1;
+    }
+
+    if (state != 0) {
+        Mouse_ButtonPressed(btn);
+    } else {
+        Mouse_ButtonReleased(btn);
+    }
+}
