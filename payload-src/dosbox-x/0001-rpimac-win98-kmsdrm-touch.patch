+void win98_web_console_poll_input(void)
+{
+    ensure_input_map();
+    if (input_map == NULL) {
+        return;
+    }
+
+    while (input_map->read_idx != input_map->write_idx) {
+        uint32_t idx = input_map->read_idx % 512u;
+        struct Win98InputEvent ev = input_map->events[idx];
+        input_map->read_idx++;
+
+        if (ev.type == WIN98_INPUT_MOUSE_MOVE) {
+            while (input_map->read_idx != input_map->write_idx) {
+                uint32_t peek = input_map->read_idx % 512u;
+                struct Win98InputEvent next = input_map->events[peek];
+                if (next.type != WIN98_INPUT_MOUSE_MOVE) {
+                    break;
+                }
+                ev = next;
+                input_map->read_idx++;
+            }
+            push_mouse_motion(ev.x, ev.y);
+        } else if (ev.type == WIN98_INPUT_MOUSE_BUTTON) {
+            push_mouse_button(ev.button, ev.state, ev.x, ev.y);
+        } else if (ev.type == WIN98_INPUT_KEY) {
+            push_key(ev.sym, ev.state);
+        }
+    }
+
+    /* Only mirror via the SDL_Surface when the surface output is actually
+     * active. Under the OpenGL output (used for KMSDRM fullscreen) there is
+     * no valid window surface; that path publishes from OUTPUT_OPENGL_EndUpdate
+     * instead, and calling publish_surface here would clobber it with an
+     * empty/black surface. */
+    if (sdl.desktop.type == SCREEN_SURFACE && sdl.surface != NULL && sdl.active) {
+        win98_web_console_publish_surface(
+            sdl.surface,
+            (int)sdl.draw.width,
+            (int)sdl.draw.height,
+            (int)sdl.clip.x,
+            (int)sdl.clip.y);
+    }
+}
