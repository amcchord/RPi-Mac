+static void push_key(uint32_t sym, uint32_t state)
+{
+    KBD_KEYS kbd = sym_to_kbd((SDL_Keycode)sym);
+    if (kbd != KBD_NONE) {
+        KEYBOARD_AddKey(kbd, state != 0);
+        return;
+    }
+
+    SDL_Event event;
+    SDL_zero(event);
+    event.type = (state != 0) ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.keysym.sym = (SDL_Keycode)sym;
+    event.key.keysym.scancode = SDL_GetScancodeFromKey((SDL_Keycode)sym);
+    event.key.state = (state != 0) ? SDL_PRESSED : SDL_RELEASED;
+    event.key.repeat = 0;
+    if (sdl.window != NULL) {
+        event.key.windowID = SDL_GetWindowID(sdl.window);
+    }
+    SDL_PushEvent(&event);
+}
