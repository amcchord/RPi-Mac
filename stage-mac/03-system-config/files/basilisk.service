[Unit]
Description=Basilisk II classic Macintosh emulator
After=systemd-user-sessions.service rpimac-boot-config.service rpimac-expand-disks.service
Wants=rpimac-boot-config.service rpimac-expand-disks.service
Conflicts=getty@tty1.service
# If the emulator keeps dying, stop restarting it and show a rescue
# console instead of a black screen.
StartLimitIntervalSec=300
StartLimitBurst=15
OnFailure=rpimac-rescue.service

[Service]
User=mac
Group=mac
# The rest of the system is pinned to core 0 (see systemd system.conf.d);
# the emulator gets cores 1-3 so the 68k thread owns a full core.
CPUAffinity=1 2 3
Nice=-2
SupplementaryGroups=video render input audio tty
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=HOME=/home/mac
WorkingDirectory=/home/mac
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/local/bin/rpimac-basilisk
Restart=always
RestartSec=3
# SIGTERM shows a Mac OS shutdown dialog instead of quitting; the emulator
# is an appliance here, so just kill it outright on stop/restart - and
# treat that kill as a normal exit, not a failure.
KillSignal=SIGKILL
SuccessExitStatus=SIGKILL
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
