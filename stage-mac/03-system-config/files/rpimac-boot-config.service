[Unit]
Description=Apply RPi-Mac settings from /boot/firmware/mac.txt
After=local-fs.target
Before=NetworkManager.service rpimac-emulator.service
RequiresMountsFor=/boot/firmware

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rpimac-boot-config
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
