#!/bin/bash
# Apply settings from /boot/firmware/mac.txt (WiFi, display, debug).
#
# Runs on every boot, before NetworkManager and the emulator. Idempotent:
# files are only rewritten when their content would actually change. If
# the firmware configuration (config.txt / cmdline.txt) changed, the Pi
# reboots once so the new display/console settings take effect; on the
# following boot nothing changes, so no reboot loop is possible.
#
# Set RPIMAC_BUILD=1 when running inside the image-build chroot: all live
# actions (NetworkManager reload, rfkill, reboot) are then skipped and only
# the configuration files are written.
set -eu

BUILD_MODE="${RPIMAC_BUILD:-0}"

MAC_TXT="/boot/firmware/mac.txt"
CONFIG_TXT="/boot/firmware/config.txt"
CMDLINE_TXT="/boot/firmware/cmdline.txt"
BOOTCOUNT_FILE="/boot/firmware/bootcount.txt"
NM_CONN_DIR="/etc/NetworkManager/system-connections"
NM_CONN="${NM_CONN_DIR}/rpimac-wifi.nmconnection"
WIFI_UUID="7e3c8d52-9a14-4b9e-8a14-2f1c64a14d0b"

FIRMWARE_CHANGED=0

if [ ! -f "${MAC_TXT}" ]; then
	echo "rpimac-boot-config: ${MAC_TXT} not found, nothing to do"
	exit 0
fi

# ----------------------------------------------------- boot attempt count ---
# Counts boots that never reached a stable state (rpimac-boot-ok resets it
# after the system has been up for a while). After 3 failed attempts the
# quiet boot is disabled automatically so problems become visible on screen.
BOOT_COUNT=0
FORCE_DEBUG=0
if [ "${BUILD_MODE}" != "1" ]; then
	if [ -f "${BOOTCOUNT_FILE}" ]; then
		BOOT_COUNT="$(tr -cd '0-9' < "${BOOTCOUNT_FILE}")"
		if [ -z "${BOOT_COUNT}" ]; then
			BOOT_COUNT=0
		fi
	fi
	BOOT_COUNT=$((BOOT_COUNT + 1))
	echo "${BOOT_COUNT}" > "${BOOTCOUNT_FILE}"
	if [ "${BOOT_COUNT}" -ge 3 ]; then
		FORCE_DEBUG=1
		echo "rpimac-boot-config: ${BOOT_COUNT} consecutive incomplete boots, enabling verbose boot"
	fi
fi

get_key() {
	local key="$1"
	local line=""
	line="$(grep -E "^${key}=" "${MAC_TXT}" | tail -n 1 || true)"
	printf '%s' "${line#*=}" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# Write a file only if the content differs. Echoes 1 if the file changed.
write_if_changed() {
	local dest="$1"
	local mode="$2"
	local content="$3"
	if [ -f "${dest}" ] && [ "$(cat "${dest}")" = "${content}" ]; then
		echo 0
		return
	fi
	printf '%s\n' "${content}" > "${dest}.tmp"
	chmod "${mode}" "${dest}.tmp"
	mv "${dest}.tmp" "${dest}"
	echo 1
}

WIFI_SSID="$(get_key WIFI_SSID)"
WIFI_PASS="$(get_key WIFI_PASS)"
WIFI_COUNTRY="$(get_key WIFI_COUNTRY)"
DISPLAY_KIND="$(get_key DISPLAY)"
ROTATE="$(get_key ROTATE)"
DEBUG="$(get_key DEBUG)"
SSH_ENABLED="$(get_key SSH)"

if [ -z "${DISPLAY_KIND}" ]; then
	DISPLAY_KIND="hdmi"
fi

# Rotation: blank means automatic (the DPI panel is portrait, so the Mac
# screen is rotated 270 degrees to appear landscape, matching the boot
# splash orientation; HDMI stays unrotated)
case "${ROTATE}" in
	0|90|180|270) ;;
	*)
		if [ "${DISPLAY_KIND}" = "dpi28" ]; then
			ROTATE=270
		else
			ROTATE=0
		fi
		;;
esac

# ----------------------------------------------------------------- WiFi ---
if [ -n "${WIFI_SSID}" ]; then
	mkdir -p "${NM_CONN_DIR}"
	NM_SECURITY=""
	if [ -n "${WIFI_PASS}" ]; then
		NM_SECURITY="
[wifi-security]
key-mgmt=wpa-psk
psk=${WIFI_PASS}"
	fi
	NM_CONTENT="[connection]
id=rpimac-wifi
uuid=${WIFI_UUID}
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=10

[wifi]
mode=infrastructure
ssid=${WIFI_SSID}
${NM_SECURITY}
[ipv4]
method=auto

[ipv6]
method=auto"
	WIFI_CHANGED="$(write_if_changed "${NM_CONN}" 600 "${NM_CONTENT}")"
	if [ "${WIFI_CHANGED}" = "1" ]; then
		echo "rpimac-boot-config: WiFi connection updated for SSID '${WIFI_SSID}'"
	fi
	if [ "${BUILD_MODE}" != "1" ]; then
		rfkill unblock wifi || true
		if systemctl is-active --quiet NetworkManager; then
			nmcli connection reload || true
		fi
	fi
fi

# Bluetooth: the radio can come up rfkill-blocked, which makes the
# adapter unpowerable and scans silently empty
if [ "${BUILD_MODE}" != "1" ]; then
	rfkill unblock bluetooth || true
fi

# ------------------------------------------------------------------ ssh ---
# SSH= in mac.txt is the source of truth (recoverable from the SD card)
if [ "${BUILD_MODE}" != "1" ]; then
	if [ "${SSH_ENABLED}" = "0" ]; then
		if systemctl is-enabled --quiet ssh 2>/dev/null; then
			systemctl disable --now ssh || true
			echo "rpimac-boot-config: SSH disabled per mac.txt"
		fi
	else
		if ! systemctl is-enabled --quiet ssh 2>/dev/null; then
			systemctl enable --now ssh || true
			echo "rpimac-boot-config: SSH enabled per mac.txt"
		fi
	fi
fi

# --------------------------------------------------- performance tuning ---
# No power saving: keep the CPU at full speed (the emulator wants it, and
# nothing here runs on battery). Screen blanking is already disabled via
# consoleblank=0 on the kernel command line.
if [ "${BUILD_MODE}" != "1" ]; then
	for GOV in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
		if [ -w "${GOV}" ] && [ "$(cat "${GOV}")" != "performance" ]; then
			echo performance > "${GOV}" || true
		fi
	done
fi

# ----------------------------------------------------- regulatory domain ---
if [ -n "${WIFI_COUNTRY}" ] && [ "${BUILD_MODE}" != "1" ]; then
	if command -v raspi-config > /dev/null; then
		CURRENT_COUNTRY="$(raspi-config nonint get_wifi_country 2>/dev/null || true)"
		if [ "${CURRENT_COUNTRY}" != "${WIFI_COUNTRY}" ]; then
			raspi-config nonint do_wifi_country "${WIFI_COUNTRY}" || true
		fi
	fi
fi

# -------------------------------------------------------------- display ---
DISPLAY_BLOCK="# >>> rpimac display (managed, do not edit) >>>"
case "${DISPLAY_KIND}" in
	dpi28)
		DISPLAY_BLOCK="${DISPLAY_BLOCK}
dtoverlay=waveshare-28dpi-3b-4b
dtoverlay=waveshare-28dpi-3b
dtoverlay=waveshare-28dpi-4b
dtoverlay=waveshare-touch-28dpi
dtoverlay=vc4-kms-dpi-2inch8"
		;;
	*)
		DISPLAY_BLOCK="${DISPLAY_BLOCK}
# DISPLAY=hdmi: no extra overlays needed"
		;;
esac
DISPLAY_BLOCK="${DISPLAY_BLOCK}
# <<< rpimac display <<<"

CONFIG_CURRENT="$(cat "${CONFIG_TXT}")"
CONFIG_STRIPPED="$(printf '%s\n' "${CONFIG_CURRENT}" | sed '/^# >>> rpimac display/,/^# <<< rpimac display/d')"
CONFIG_NEW="${CONFIG_STRIPPED}

${DISPLAY_BLOCK}"
# Collapse any accumulated blank lines at the end of file
CONFIG_NEW="$(printf '%s\n' "${CONFIG_NEW}" | cat -s)"
CONFIG_CHANGED="$(write_if_changed "${CONFIG_TXT}" 755 "${CONFIG_NEW}")"
if [ "${CONFIG_CHANGED}" = "1" ]; then
	echo "rpimac-boot-config: display set to ${DISPLAY_KIND} in config.txt"
	FIRMWARE_CHANGED=1
fi

# -------------------------------------------------------------- cmdline ---
CMDLINE_CURRENT="$(tr -d '\n' < "${CMDLINE_TXT}")"
CMDLINE_KEPT=""
for TOKEN in ${CMDLINE_CURRENT}; do
	case "${TOKEN}" in
		quiet|splash|logo.nologo|plymouth.ignore-serial-consoles) ;;
		loglevel=*|vt.global_cursor_default=*|systemd.show_status=*|udev.log_level=*|consoleblank=*) ;;
		plymouth.splash=*) ;;
		video=DPI-1:*) ;;
		*)
			CMDLINE_KEPT="${CMDLINE_KEPT} ${TOKEN}"
			;;
	esac
done
CMDLINE_KEPT="${CMDLINE_KEPT# }"

CMDLINE_NEW="${CMDLINE_KEPT}"
if [ "${DISPLAY_KIND}" = "dpi28" ]; then
	if [ "${ROTATE}" = "0" ]; then
		CMDLINE_NEW="video=DPI-1:480x640M@60 ${CMDLINE_NEW}"
	else
		CMDLINE_NEW="video=DPI-1:480x640M@60,rotate=${ROTATE} ${CMDLINE_NEW}"
	fi
fi
if [ "${DEBUG}" != "1" ] && [ "${FORCE_DEBUG}" != "1" ]; then
	# Boot splash variant matching the emulator rotation (the classicmac
	# theme ships pre-rotated as classicmac/classicmac90/180/270)
	SPLASH_THEME="classicmac"
	if [ "${ROTATE}" != "0" ]; then
		SPLASH_THEME="classicmac${ROTATE}"
	fi
	CMDLINE_NEW="${CMDLINE_NEW} quiet splash plymouth.splash=${SPLASH_THEME} loglevel=3 logo.nologo vt.global_cursor_default=0 systemd.show_status=0 udev.log_level=3 consoleblank=0 plymouth.ignore-serial-consoles"
fi

CMDLINE_CHANGED="$(write_if_changed "${CMDLINE_TXT}" 755 "${CMDLINE_NEW}")"
if [ "${CMDLINE_CHANGED}" = "1" ]; then
	echo "rpimac-boot-config: cmdline.txt updated (DEBUG=${DEBUG}, DISPLAY=${DISPLAY_KIND})"
	FIRMWARE_CHANGED=1
fi

# ----------------------------------------------------- emulator rotation ---
PREFS="/home/mac/.basilisk_ii_prefs"
if [ ! -f "${PREFS}" ] && [ -f /etc/rpimac/prefs.default ]; then
	cp /etc/rpimac/prefs.default "${PREFS}"
	chown mac:mac "${PREFS}" 2>/dev/null || true
fi
if [ -f "${PREFS}" ]; then
	if grep -q "^sdlrotate " "${PREFS}"; then
		if ! grep -q "^sdlrotate ${ROTATE}$" "${PREFS}"; then
			sed -i "s/^sdlrotate .*/sdlrotate ${ROTATE}/" "${PREFS}"
			echo "rpimac-boot-config: emulator rotation set to ${ROTATE}"
		fi
	else
		echo "sdlrotate ${ROTATE}" >> "${PREFS}"
		echo "rpimac-boot-config: emulator rotation set to ${ROTATE}"
	fi
fi

# --------------------------------------------------------------- reboot ---
if [ "${FIRMWARE_CHANGED}" = "1" ] && [ "${BUILD_MODE}" != "1" ]; then
	if [ "${BOOT_COUNT}" -ge 5 ]; then
		# Guard against any possibility of an automatic reboot loop:
		# after repeated incomplete boots, stop rebooting and let the
		# system come up with whatever configuration it has.
		echo "rpimac-boot-config: firmware config changed but too many boot attempts (${BOOT_COUNT}), NOT rebooting"
	else
		echo "rpimac-boot-config: firmware configuration changed, rebooting to apply"
		systemctl reboot
	fi
fi

exit 0
