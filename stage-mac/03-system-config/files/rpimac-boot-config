#!/bin/bash
# Apply settings from /boot/firmware/mac.txt (WiFi, display, debug).
#
# Runs on every boot, before NetworkManager and the emulator. Idempotent:
# files are only rewritten when their content would actually change. If
# the firmware configuration (config.txt / cmdline.txt) changed, the Pi
# reboots once so the new display/console settings take effect; on the
# following boot nothing changes, so no reboot loop is possible.
#
# Set RPIMAC_BUILD=1 to run inside the image-build chroot: paths are then
# resolved under ${ROOTFS_DIR:-/} and all live actions (NetworkManager
# reload, rfkill, reboot) are skipped.
set -eu

BUILD_MODE="${RPIMAC_BUILD:-0}"
ROOT="${ROOTFS_DIR:-}"
if [ "${BUILD_MODE}" != "1" ]; then
	ROOT=""
fi

MAC_TXT="${ROOT}/boot/firmware/mac.txt"
CONFIG_TXT="${ROOT}/boot/firmware/config.txt"
CMDLINE_TXT="${ROOT}/boot/firmware/cmdline.txt"
NM_CONN_DIR="${ROOT}/etc/NetworkManager/system-connections"
NM_CONN="${NM_CONN_DIR}/rpimac-wifi.nmconnection"
WIFI_UUID="7e3c8d52-9a14-4b9e-8a14-2f1c64a14d0b"

FIRMWARE_CHANGED=0

if [ ! -f "${MAC_TXT}" ]; then
	echo "rpimac-boot-config: ${MAC_TXT} not found, nothing to do"
	exit 0
fi

get_key() {
	local key="$1"
	local line=""
	line="$(grep -E "^${key}=" "${MAC_TXT}" | tail -n 1 || true)"
	printf '%s' "${line#*=}" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# Write a file only if the content differs. Echoes 1 if the file changed.
write_if_changed() {
	local dest="$1"
	local mode="$2"
	local content="$3"
	if [ -f "${dest}" ] && [ "$(cat "${dest}")" = "${content}" ]; then
		echo 0
		return
	fi
	printf '%s\n' "${content}" > "${dest}.tmp"
	chmod "${mode}" "${dest}.tmp"
	mv "${dest}.tmp" "${dest}"
	echo 1
}

WIFI_SSID="$(get_key WIFI_SSID)"
WIFI_PASS="$(get_key WIFI_PASS)"
WIFI_COUNTRY="$(get_key WIFI_COUNTRY)"
DISPLAY_KIND="$(get_key DISPLAY)"
DEBUG="$(get_key DEBUG)"

if [ -z "${DISPLAY_KIND}" ]; then
	DISPLAY_KIND="hdmi"
fi

# ----------------------------------------------------------------- WiFi ---
if [ -n "${WIFI_SSID}" ]; then
	mkdir -p "${NM_CONN_DIR}"
	NM_SECURITY=""
	if [ -n "${WIFI_PASS}" ]; then
		NM_SECURITY="
[wifi-security]
key-mgmt=wpa-psk
psk=${WIFI_PASS}"
	fi
	NM_CONTENT="[connection]
id=rpimac-wifi
uuid=${WIFI_UUID}
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=10

[wifi]
mode=infrastructure
ssid=${WIFI_SSID}
${NM_SECURITY}
[ipv4]
method=auto

[ipv6]
method=auto"
	WIFI_CHANGED="$(write_if_changed "${NM_CONN}" 600 "${NM_CONTENT}")"
	if [ "${WIFI_CHANGED}" = "1" ]; then
		echo "rpimac-boot-config: WiFi connection updated for SSID '${WIFI_SSID}'"
	fi
	if [ "${BUILD_MODE}" != "1" ]; then
		rfkill unblock wifi || true
		if systemctl is-active --quiet NetworkManager; then
			nmcli connection reload || true
		fi
	fi
fi

# ----------------------------------------------------- regulatory domain ---
if [ -n "${WIFI_COUNTRY}" ] && [ "${BUILD_MODE}" != "1" ]; then
	if command -v raspi-config > /dev/null; then
		CURRENT_COUNTRY="$(raspi-config nonint get_wifi_country 2>/dev/null || true)"
		if [ "${CURRENT_COUNTRY}" != "${WIFI_COUNTRY}" ]; then
			raspi-config nonint do_wifi_country "${WIFI_COUNTRY}" || true
		fi
	fi
fi

# -------------------------------------------------------------- display ---
DISPLAY_BLOCK="# >>> rpimac display (managed, do not edit) >>>"
case "${DISPLAY_KIND}" in
	dpi28)
		DISPLAY_BLOCK="${DISPLAY_BLOCK}
dtoverlay=waveshare-28dpi-3b-4b
dtoverlay=waveshare-28dpi-3b
dtoverlay=waveshare-28dpi-4b
dtoverlay=waveshare-touch-28dpi
dtoverlay=vc4-kms-dpi-2inch8"
		;;
	*)
		DISPLAY_BLOCK="${DISPLAY_BLOCK}
# DISPLAY=hdmi: no extra overlays needed"
		;;
esac
DISPLAY_BLOCK="${DISPLAY_BLOCK}
# <<< rpimac display <<<"

CONFIG_CURRENT="$(cat "${CONFIG_TXT}")"
CONFIG_STRIPPED="$(printf '%s\n' "${CONFIG_CURRENT}" | sed '/^# >>> rpimac display/,/^# <<< rpimac display/d')"
CONFIG_NEW="${CONFIG_STRIPPED}

${DISPLAY_BLOCK}"
# Collapse any accumulated blank lines at the end of file
CONFIG_NEW="$(printf '%s\n' "${CONFIG_NEW}" | cat -s)"
CONFIG_CHANGED="$(write_if_changed "${CONFIG_TXT}" 755 "${CONFIG_NEW}")"
if [ "${CONFIG_CHANGED}" = "1" ]; then
	echo "rpimac-boot-config: display set to ${DISPLAY_KIND} in config.txt"
	FIRMWARE_CHANGED=1
fi

# -------------------------------------------------------------- cmdline ---
CMDLINE_CURRENT="$(tr -d '\n' < "${CMDLINE_TXT}")"
CMDLINE_KEPT=""
for TOKEN in ${CMDLINE_CURRENT}; do
	case "${TOKEN}" in
		quiet|splash|logo.nologo|plymouth.ignore-serial-consoles) ;;
		loglevel=*|vt.global_cursor_default=*|systemd.show_status=*|udev.log_level=*|consoleblank=*) ;;
		video=DPI-1:*) ;;
		*)
			CMDLINE_KEPT="${CMDLINE_KEPT} ${TOKEN}"
			;;
	esac
done
CMDLINE_KEPT="${CMDLINE_KEPT# }"

CMDLINE_NEW="${CMDLINE_KEPT}"
if [ "${DISPLAY_KIND}" = "dpi28" ]; then
	CMDLINE_NEW="video=DPI-1:480x640M@60,rotate=90 ${CMDLINE_NEW}"
fi
if [ "${DEBUG}" != "1" ]; then
	CMDLINE_NEW="${CMDLINE_NEW} quiet splash loglevel=3 logo.nologo vt.global_cursor_default=0 systemd.show_status=0 udev.log_level=3 consoleblank=0 plymouth.ignore-serial-consoles"
fi

CMDLINE_CHANGED="$(write_if_changed "${CMDLINE_TXT}" 755 "${CMDLINE_NEW}")"
if [ "${CMDLINE_CHANGED}" = "1" ]; then
	echo "rpimac-boot-config: cmdline.txt updated (DEBUG=${DEBUG}, DISPLAY=${DISPLAY_KIND})"
	FIRMWARE_CHANGED=1
fi

# --------------------------------------------------------------- reboot ---
if [ "${FIRMWARE_CHANGED}" = "1" ] && [ "${BUILD_MODE}" != "1" ]; then
	echo "rpimac-boot-config: firmware configuration changed, rebooting to apply"
	systemctl reboot
fi

exit 0
