+
+// RPi-Mac: runtime toggle for the fast dirty-region scan (default on). Set
+// RPIMAC_VIDEO_FASTSCAN=0 to fall back to the legacy per-tile memcmp scan
+// (handy for A/B measurement and as a safety hatch).
+static bool rpimac_video_fastscan_on(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		const char *e = getenv("RPIMAC_VIDEO_FASTSCAN");
+		if (e != NULL && e[0] == '0')
+			state = 0;
+		else
+			state = 1;
+	}
+	return state != 0;
+}
+
+// RPi-Mac: toggle the NEON row-diff (default on where built). Set
+// RPIMAC_VIDEO_NEON=0 to use the scalar word comparison instead.
+static bool rpimac_video_neon_on(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		const char *e = getenv("RPIMAC_VIDEO_NEON");
+		if (e != NULL && e[0] == '0')
+			state = 0;
+		else
+			state = 1;
+	}
+	return state != 0;
+}
+
+// Compare one row of 32-bit pixels against its shadow. Returns true if the row
+// differs and, when it does, the half-open changed column span [first, last).
+// This is the hot inner loop of the dirty scan; it runs once per row per frame.
+static inline bool rpimac_row_diff32(const uint32 *a, const uint32 *b,
+                                     uint32 width, bool use_neon,
+                                     uint32 *first, uint32 *last)
+{
+	uint32 f = width;
+	uint32 l = 0;
+	uint32 i = 0;
+#if defined(__aarch64__)
+	if (use_neon) {
+		// 4 pixels (16 bytes) per compare. Most rows are identical to their
+		// shadow, so the all-equal chunk test is the common, cheap path.
+		for (; i + 4 <= width; i += 4) {
+			uint32x4_t va = vld1q_u32(a + i);
+			uint32x4_t vb = vld1q_u32(b + i);
+			uint32x4_t eq = vceqq_u32(va, vb);
+			uint64x2_t e64 = vreinterpretq_u64_u32(eq);
+			if (vgetq_lane_u64(e64, 0) == ~0ULL && vgetq_lane_u64(e64, 1) == ~0ULL)
+				continue;	// all four pixels equal
+			for (uint32 k = 0; k < 4; k++) {
+				if (a[i + k] != b[i + k]) {
+					if (i + k < f) f = i + k;
+					if (i + k + 1 > l) l = i + k + 1;
+				}
+			}
+		}
+	}
+#else
+	(void)use_neon;
+#endif
+	for (; i < width; i++) {
+		if (a[i] != b[i]) {
+			if (i < f) f = i;
+			if (i + 1 > l) l = i + 1;
+		}
+	}
+	if (l == 0)
+		return false;
+	*first = f;
+	*last = l;
+	return true;
+}
+
+// Dirty bounding box (half-open in x, inclusive in y). An "empty" result has
+// y_min > y_max, achieved by initialising the bounds to their extremes so that
+// empty bands are neutral when merged with min()/max().
+struct rpimac_bbox {
+	uint32 y_min, y_max, x_min, x_max;
+};
+
+static inline void rpimac_bbox_init(rpimac_bbox *r, uint32 width)
+{
+	r->y_min = 0xffffffffu;
+	r->y_max = 0;
+	r->x_min = width;
+	r->x_max = 0;
+}
+
+// Read-only dirty scan of rows [row0, row1) for a 32-bit framebuffer. Pure
+// (touches only its own result), so it is safe to run concurrently on disjoint
+// bands. Writes to the shadow copy happen later, single-threaded.
+static void rpimac_scan_band_32(const uint8 *buf, const uint8 *shadow,
+                                uint32 bytes_per_row, uint32 row_bytes, uint32 width,
+                                uint32 row0, uint32 row1, bool use_neon, rpimac_bbox *r)
+{
+	for (uint32 j = row0; j < row1; j++) {
+		const uint32 *a = (const uint32 *)&buf[j * bytes_per_row];
+		const uint32 *b = (const uint32 *)&shadow[j * bytes_per_row];
+		if (memcmp(a, b, row_bytes) == 0)
+			continue;
+		if (j < r->y_min) r->y_min = j;
+		r->y_max = j;
+		uint32 f = 0, l = width;
+		rpimac_row_diff32(a, b, width, use_neon, &f, &l);
+		if (f < r->x_min) r->x_min = f;
+		if (l > r->x_max) r->x_max = l;
+	}
+}
+
+// RPi-Mac: number of threads to split the read-only dirty scan across (default
+// 1 = scan on the redraw thread only). RPIMAC_VIDEO_SCAN_THREADS=2|3 fans the
+// scan out across a small persistent pool. On the Pi Zero 2 the scan is largely
+// memory-bandwidth bound, so >1 rarely helps; this is a measured, opt-in knob.
+static int rpimac_video_scan_threads(void)
+{
+	static int n = -1;
+	if (n < 0) {
+		n = 1;
+		const char *e = getenv("RPIMAC_VIDEO_SCAN_THREADS");
+		if (e != NULL && e[0] != '\0') {
+			n = atoi(e);
+			if (n < 1) n = 1;
+			if (n > 4) n = 4;
+		}
+	}
+	return n;
+}
+
+// Persistent worker pool for the parallel scan. Workers are created lazily on
+// first use and live for the process lifetime; each waits for a generation
+// bump, scans its assigned band read-only, and reports completion.
+struct rpimac_scan_job {
+	const uint8 *buf;
+	const uint8 *shadow;
+	uint32 bytes_per_row, row_bytes, width;
+	bool use_neon;
+	uint32 row_split[5];	// band boundaries for up to 4 threads
+	rpimac_bbox result[4];
+};
+
+static SDL_mutex *rpimac_scan_mutex = NULL;
+static SDL_cond *rpimac_scan_go = NULL;
+static SDL_cond *rpimac_scan_done = NULL;
+static rpimac_scan_job rpimac_scan_cur;
+static uint64 rpimac_scan_gen = 0;		// bumped to release the workers
+static int rpimac_scan_pending = 0;		// worker bands still running
+static int rpimac_scan_nthreads = 1;	// active thread count for this pool
+
+static int rpimac_scan_worker(void *arg)
+{
+	size_t idx = (size_t)arg;		// band index 1..nthreads-1
+	uint64 seen = 0;
+	for (;;) {
+		SDL_LockMutex(rpimac_scan_mutex);
+		while (rpimac_scan_gen == seen)
+			SDL_CondWait(rpimac_scan_go, rpimac_scan_mutex);
+		seen = rpimac_scan_gen;
+		rpimac_scan_job job = rpimac_scan_cur;	// copy stable params
+		SDL_UnlockMutex(rpimac_scan_mutex);
+
+		rpimac_bbox local;
+		rpimac_bbox_init(&local, job.width);
+		rpimac_scan_band_32(job.buf, job.shadow, job.bytes_per_row, job.row_bytes,
+		                    job.width, job.row_split[idx], job.row_split[idx + 1],
+		                    job.use_neon, &local);
+
+		SDL_LockMutex(rpimac_scan_mutex);
+		rpimac_scan_cur.result[idx] = local;
+		rpimac_scan_pending--;
+		SDL_CondSignal(rpimac_scan_done);
+		SDL_UnlockMutex(rpimac_scan_mutex);
+	}
+	return 0;
+}
+
+// Ensure the pool has (n-1) workers running. Idempotent; only ever grows.
+static void rpimac_scan_pool_ensure(int n)
+{
+	if (rpimac_scan_mutex == NULL) {
+		rpimac_scan_mutex = SDL_CreateMutex();
+		rpimac_scan_go = SDL_CreateCond();
+		rpimac_scan_done = SDL_CreateCond();
+	}
+	for (int k = rpimac_scan_nthreads; k < n; k++) {
+		// Worker k handles band index k (1..n-1); the caller is band 0.
+		SDL_Thread *t = SDL_CreateThread(rpimac_scan_worker, "rpimac-scan", (void *)(size_t)k);
+		if (t == NULL)
+			break;
+		SDL_DetachThread(t);
+		rpimac_scan_nthreads = k + 1;
+	}
+}
+
+// Fast contiguous bounding-box dirty scan (RPi-Mac).
+//
+// The legacy update_display_static_bbox() compared the framebuffer to its
+// shadow copy in 64x64 tiles. On a 32-bit screen that is thousands of tiny,
+// strided memcmp() calls per refresh - measured at ~30% of a CPU core even
+// when nothing changes, and rising with resolution. It is also wasted
+// precision: present_sdl_video() only ever uploads the *union* of the dirty
+// boxes (a single rectangle), so the per-tile detail is discarded at once.
+//
+// This version finds the same bounding rectangle far more cheaply by working
+// on contiguous rows:
+//   1) full-row compares to find the first changed row (doubles as the
+//      static-screen early-out - returns the moment a busy frame differs,
+//      and reads the buffer at most once when idle);
+//   2) full-row compares from the bottom for the last changed row (y1..y2);
+//   3) word-wise compares across that band for the changed columns (x1..x2);
+//   4) one shadow-copy + one dirty rect for the bounding box.
+static void update_display_static_bbox_fast(driver_base *drv)
+{
+	const VIDEO_MODE &mode = drv->mode;
+	const bool blit = (int)VIDEO_MODE_DEPTH == VIDEO_DEPTH_16BIT;
+	const uint32 bytes_per_row = VIDEO_MODE_ROW_BYTES;
+	const uint32 width = VIDEO_MODE_X;
+	const uint32 height = VIDEO_MODE_Y;
+	const uint32 bytes_per_pixel = bytes_per_row / width;
+	const uint32 row_bytes = width * bytes_per_pixel;	// active bytes per row
+	const uint32 dst_bytes_per_row = drv->s->pitch;
+
+	bool tele = rpimac_video_tele_on();
+	uint64 scan_t0 = 0;
+	if (tele)
+		scan_t0 = rpimac_video_now_ns();
+
+	uint32 y1 = height, y2 = 0, x1 = width, x2 = 0;
+
+	if (bytes_per_pixel == 4) {
+		// Compute the exact dirty bounding box. Per-row change detection uses
+		// memcmp() (glibc implements it in tuned NEON assembly and early-outs
+		// at the first differing byte - this beats a hand-rolled per-row SIMD
+		// compare for the common "row unchanged" case); only changed rows pay
+		// for the column-extent scan, where the optional NEON path helps.
+		const bool use_neon = rpimac_video_neon_on();
+		int nthreads = rpimac_video_scan_threads();
+		if (nthreads > 1 && height >= (uint32)(nthreads * 16)) {
+			rpimac_scan_pool_ensure(nthreads);
+			if (rpimac_scan_nthreads < nthreads)
+				nthreads = rpimac_scan_nthreads;
+		} else {
+			nthreads = 1;
+		}
+
+		rpimac_bbox merged;
+		rpimac_bbox_init(&merged, width);
+		if (nthreads <= 1) {
+			rpimac_scan_band_32(the_buffer, the_buffer_copy, bytes_per_row,
+			                    row_bytes, width, 0, height, use_neon, &merged);
+		} else {
+			// Fan the read-only scan out across the pool; this thread takes
+			// band 0, the workers take 1..nthreads-1, then we merge.
+			SDL_LockMutex(rpimac_scan_mutex);
+			rpimac_scan_cur.buf = the_buffer;
+			rpimac_scan_cur.shadow = the_buffer_copy;
+			rpimac_scan_cur.bytes_per_row = bytes_per_row;
+			rpimac_scan_cur.row_bytes = row_bytes;
+			rpimac_scan_cur.width = width;
+			rpimac_scan_cur.use_neon = use_neon;
+			for (int k = 0; k <= nthreads; k++)
+				rpimac_scan_cur.row_split[k] = (uint32)((uint64)height * k / nthreads);
+			uint32 b0_start = rpimac_scan_cur.row_split[0];
+			uint32 b0_end = rpimac_scan_cur.row_split[1];
+			rpimac_scan_pending = nthreads - 1;
+			rpimac_scan_gen++;
+			SDL_CondBroadcast(rpimac_scan_go);
+			SDL_UnlockMutex(rpimac_scan_mutex);
+
+			rpimac_scan_band_32(the_buffer, the_buffer_copy, bytes_per_row,
+			                    row_bytes, width, b0_start, b0_end, use_neon, &merged);
+
+			SDL_LockMutex(rpimac_scan_mutex);
+			while (rpimac_scan_pending > 0)
+				SDL_CondWait(rpimac_scan_done, rpimac_scan_mutex);
+			for (int k = 1; k < nthreads; k++) {
+				const rpimac_bbox *r = &rpimac_scan_cur.result[k];
+				if (r->y_min < merged.y_min) merged.y_min = r->y_min;
+				if (r->y_max > merged.y_max) merged.y_max = r->y_max;
+				if (r->x_min < merged.x_min) merged.x_min = r->x_min;
+				if (r->x_max > merged.x_max) merged.x_max = r->x_max;
+			}
+			SDL_UnlockMutex(rpimac_scan_mutex);
+		}
+		y1 = merged.y_min;
+		y2 = merged.y_max;
+		x1 = merged.x_min;
+		x2 = merged.x_max;
+	} else {
+		// Generic path (8/16-bit): vertical bounds via full-row memcmp, then a
+		// byte-wise column narrowing across the changed band.
+		for (uint32 j = 0; j < height; j++) {
+			if (memcmp(&the_buffer[j * bytes_per_row], &the_buffer_copy[j * bytes_per_row], row_bytes) != 0) {
+				y1 = j;
+				break;
+			}
+		}
+		if (y1 != height) {
+			for (uint32 j = height; j-- > y1; ) {
+				if (memcmp(&the_buffer[j * bytes_per_row], &the_buffer_copy[j * bytes_per_row], row_bytes) != 0) {
+					y2 = j;
+					break;
+				}
+			}
+			for (uint32 j = y1; j <= y2; j++) {
+				const uint8 *a = &the_buffer[j * bytes_per_row];
+				const uint8 *b = &the_buffer_copy[j * bytes_per_row];
+				uint32 i = 0;
+				while (i < x1 && memcmp(a + i * bytes_per_pixel, b + i * bytes_per_pixel, bytes_per_pixel) == 0) i++;
+				if (i < x1) x1 = i;
+				uint32 k = width;
+				while (k > x2 && memcmp(a + (k - 1) * bytes_per_pixel, b + (k - 1) * bytes_per_pixel, bytes_per_pixel) == 0) k--;
+				if (k > x2) x2 = k;
+				if (x1 == 0 && x2 == width)
+					break;
+			}
+		}
+	}
+
+	if (y1 > y2 || x2 <= x1) {	// nothing visibly changed - the common idle case
+		if (tele) {
+			rpimac_tele_bbox_ns += rpimac_video_now_ns() - scan_t0;
+			rpimac_tele_scan_bytes += (uint64)row_bytes * height;
+		}
+		return;
+	}
+
+	const uint32 wide = x2 - x1;
+	const uint32 high = y2 - y1 + 1;
+	const uint32 xb = x1 * bytes_per_pixel;
+	const uint32 xs = wide * bytes_per_pixel;
+
+	// Update the shadow copy (and convert for 16-bit) over the bounding rect
+	// only, then publish a single dirty rectangle.
+	if (SDL_MUSTLOCK(drv->s))
+		SDL_LockSurface(drv->s);
+	for (uint32 j = y1; j <= y2; j++) {
+		const uint32 yb = j * bytes_per_row;
+		memcpy(&the_buffer_copy[yb + xb], &the_buffer[yb + xb], xs);
+		if (blit)
+			Screen_blit((uint8 *)drv->s->pixels + j * dst_bytes_per_row + xb, the_buffer + yb + xb, xs);
+	}
+	if (SDL_MUSTLOCK(drv->s))
+		SDL_UnlockSurface(drv->s);
+
+	if (tele) {
+		rpimac_tele_bbox_ns += rpimac_video_now_ns() - scan_t0;
+		rpimac_tele_scan_bytes += (uint64)row_bytes * height;
+		rpimac_tele_dirty_bytes += (uint64)wide * high * bytes_per_pixel;
+	}
+
+	SDL_Rect box;
+	box.x = x1;
+	box.y = y1;
+	box.w = wide;
+	box.h = high;
+	update_sdl_video(drv->s, 1, &box);
+}
