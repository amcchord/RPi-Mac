+/*
+ *  RPi-Mac video-path telemetry (env-gated; near-zero cost when off)
+ *
+ *  These accumulators are sampled once per second by the reporter in
+ *  main_unix.cpp to attribute host-side video cost between its three stages:
+ *  the dirty-region scan (update_display_static_bbox), the texture upload
+ *  (SDL_LockTexture + per-row copy), and presentation (SDL_RenderCopyEx +
+ *  SDL_RenderPresent). They are plain cross-thread counters - the scan runs on
+ *  the redraw thread and present on the renderer thread - so a sample can
+ *  momentarily race a write; that is acceptable for perf diagnostics and the
+ *  whole path is compiled out of the hot loop unless RPIMAC_TELEMETRY is set.
+ */
+volatile uint64 rpimac_tele_bbox_ns = 0;      // wall time in the dirty scan
+volatile uint64 rpimac_tele_scan_bytes = 0;   // framebuffer bytes compared
+volatile uint64 rpimac_tele_dirty_bytes = 0;  // framebuffer bytes found changed
+volatile uint64 rpimac_tele_upload_ns = 0;    // texture lock + row-copy time
+volatile uint64 rpimac_tele_upload_bytes = 0; // bytes copied into the texture
+volatile uint64 rpimac_tele_present_ns = 0;   // RenderCopyEx + RenderPresent
+volatile uint32 rpimac_tele_fb_bytes = 0;     // current framebuffer size (w*h*4)
+
+static bool rpimac_video_tele_on(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		const char *e = getenv("RPIMAC_TELEMETRY");
+		if (e != NULL && e[0] != '\0' && e[0] != '0')
+			state = 1;
+		else
+			state = 0;
+	}
+	return state != 0;
+}
+
+static inline uint64 rpimac_video_now_ns(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64)ts.tv_sec * 1000000000ULL + (uint64)ts.tv_nsec;
+}
