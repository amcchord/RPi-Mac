+// Hot-path JIT tracing is opt-in (B2_JIT_TRACE=1). These fprintf+fflush on every
+// dispatch/block, which floods the journal and cripples throughput when left on.
+static bool jit_hot_trace(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		const char *e = getenv("B2_JIT_TRACE");
+		cached = (e && e[0] && strcmp(e, "0") != 0) ? 1 : 0;
+	}
+	return cached != 0;
+}
