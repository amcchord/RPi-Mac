+// --- Lazy 0xFF bus regions --------------------------------------------------
+// The Mac I/O and NuBus probe regions read back 0xFF on the empty bus. Eagerly
+// memset-ing them to 0xFF commits ~650 MB of RAM, which over-commits a 415 MB
+// Pi Zero 2 and thrashes zram into unreachability. Instead we leave those
+// regions PROT_NONE / unmapped and commit one 0xFF page at a time, on first
+// access, from the SIGSEGV handler below. Only the handful of pages the ROM/OS
+// actually probes ever consume RAM, while reads still see the 0xFF bus value.
+struct lazy_ff_range_t { uintptr start; uintptr end; };
+static lazy_ff_range_t lazy_ff_ranges[8];
+static int lazy_ff_count = 0;
+
+static void register_lazy_ff(uintptr host_start, size_t size)
+{
+	if (lazy_ff_count < (int)(sizeof(lazy_ff_ranges) / sizeof(lazy_ff_ranges[0]))) {
+		lazy_ff_ranges[lazy_ff_count].start = host_start;
+		lazy_ff_ranges[lazy_ff_count].end   = host_start + size;
+		lazy_ff_count++;
+	}
+}
+
+static bool lazy_ff_commit_page(uintptr fault_address)
+{
+	for (int i = 0; i < lazy_ff_count; i++) {
+		if (fault_address >= lazy_ff_ranges[i].start &&
+		    fault_address <  lazy_ff_ranges[i].end) {
+			const size_t pg = (size_t)getpagesize();
+			void *page = (void *)(fault_address & ~(uintptr)(pg - 1));
+			void *r = mmap(page, pg, PROT_READ | PROT_WRITE,
+				MAP_ANONYMOUS | MAP_PRIVATE | MAP_FIXED, -1, 0);
+			if (r == MAP_FAILED)
+				return false;
+			memset(r, 0xFF, pg);
+			return true;
+		}
+	}
+	return false;
+}
+
