 #ifdef USE_SDL_VIDEO
 	{"sdlrender", TYPE_STRING, false,      "SDL_Renderer driver (\"auto\", \"software\" (may be faster), etc.)"},
+	{"sdlrotate", TYPE_INT32, false,       "rotate video output (0/90/180/270 degrees)"},
 #endif
 	{NULL, TYPE_END, false, NULL} // End of list
 };
