+// Mirror the current frame into /dev/shm so the RPi-Mac web console can
+// show a live view of the Mac screen. Throttled to ~15 fps.
+// Where the guest image actually sits in window space (after rotation,
+// scaling, and the margin offsets). Shared between rendering, absolute
+// input mapping and the web-console shm header so they can never drift.
+static SDL_Rect output_visible = { 0, 0, 0, 0 };
+static int output_win_w = 0;
+static int output_win_h = 0;
+
+static int output_rotation(void)
+{
+	static int rot = -1;
+	if (rot < 0)
+		rot = ((PrefsFindInt32("sdlrotate") % 360) + 360) % 360;
+	return rot;
+}
+
+static void output_offsets(int *ox, int *oy)
+{
+	static int cox = 0;
+	static int coy = 0;
+	static bool loaded = false;
+	if (!loaded) {
+		cox = PrefsFindInt32("sdloffsetx");
+		coy = PrefsFindInt32("sdloffsety");
+		loaded = true;
+	}
+	*ox = cox;
+	*oy = coy;
+}
+
+// Accumulated guest-screen changes since the last successful publish,
+// so the web console can fetch partial (VNC-style) updates.
+static SDL_Rect shm_dirty_acc = { 0, 0, 0, 0 };
+
+static void screen_shm_publish(void)
+{
+	static int shm_fd = -2;
+	static uint8 *shm_map = NULL;
+	static size_t shm_size = 0;
+	static uint32 last_publish = 0;
+
+	if (host_surface == NULL)
+		return;
+	uint32 now = SDL_GetTicks();
+	if (now - last_publish < 66)
+		return;
+	last_publish = now;
+
+	// Publish only while someone is actually watching: the web UI touches
+	// this token on every frame request. No viewer = no copying at all
+	// (the dirty rectangle keeps accumulating for when a viewer returns).
+	{
+		struct stat want;
+		if (stat("/dev/shm/rpimac-screen-want", &want) != 0)
+			return;
+		time_t wall = time(NULL);
+		if (wall - want.st_mtime > 10)
+			return;
+	}
+
+	size_t need = 80 + (size_t)host_surface->w * host_surface->h * 4;
+	// If something removed the file (e.g. logind RemoveIPC), start over
+	if (shm_fd >= 0) {
+		struct stat st;
+		if (stat("/dev/shm/rpimac-screen", &st) != 0) {
+			close(shm_fd);
+			shm_fd = -2;
+			if (shm_map != NULL) {
+				munmap(shm_map, shm_size);
+				shm_map = NULL;
+				shm_size = 0;
+			}
+		}
+	}
+	if (shm_fd == -2)
+		shm_fd = open("/dev/shm/rpimac-screen", O_RDWR | O_CREAT, 0644);
+	if (shm_fd < 0) {
+		shm_fd = -2; // retry next time
+		return;
+	}
+	bool full_copy = false;
+	if (shm_size != need) {
+		if (shm_map != NULL) {
+			munmap(shm_map, shm_size);
+			shm_map = NULL;
+			shm_size = 0;
+		}
+		if (ftruncate(shm_fd, need) != 0)
+			return;
+		void *m = mmap(NULL, need, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
+		if (m == MAP_FAILED)
+			return;
+		shm_map = (uint8 *)m;
+		shm_size = need;
+		full_copy = true; // fresh mapping: populate the whole frame
+	}
+
+	uint32 *hdr = (uint32 *)shm_map;
+	hdr[0] = 0x52504d34; // 'RPM4'
+	hdr[1] = (uint32)host_surface->w;
+	hdr[2] = (uint32)host_surface->h;
+	// Byte offsets of R, G, B within each little-endian 32-bit pixel.
+	// Basilisk pushes host_surface bytes into the texture unconverted, so
+	// the texture format (not the surface masks, which can be wrong on
+	// little-endian hosts) describes what these bytes really mean.
+	Uint32 tex_format = SDL_PIXELFORMAT_ARGB8888;
+	if (sdl_texture != NULL)
+		SDL_QueryTexture(sdl_texture, &tex_format, NULL, NULL, NULL);
+	if (tex_format == SDL_PIXELFORMAT_BGRA8888) {
+		hdr[4] = 1; // A,R,G,B in memory
+		hdr[5] = 2;
+		hdr[6] = 3;
+	} else {
+		hdr[4] = 2; // ARGB8888: B,G,R,A in memory
+		hdr[5] = 1;
+		hdr[6] = 0;
+	}
+	hdr[7] = 0;
+	// Dirty rectangle of this publish (clamped to the surface). The
+	// accumulator is shared with the emulation thread, so take the same
+	// mutex that guards the update rect.
+	SDL_LockMutex(sdl_update_video_mutex);
+	SDL_Rect dirty = shm_dirty_acc;
+	shm_dirty_acc.x = 0;
+	shm_dirty_acc.y = 0;
+	shm_dirty_acc.w = 0;
+	shm_dirty_acc.h = 0;
+	SDL_UnlockMutex(sdl_update_video_mutex);
+	SDL_Rect full = { 0, 0, host_surface->w, host_surface->h };
+	if (SDL_RectEmpty(&dirty)) {
+		if (!full_copy)
+			return; // nothing changed since the last publish
+		dirty = full;
+	} else {
+		SDL_IntersectRect(&dirty, &full, &dirty);
+	}
+	if (full_copy)
+		dirty = full;
+	hdr[8] = (uint32)dirty.x;
+	hdr[9] = (uint32)dirty.y;
+	hdr[10] = (uint32)dirty.w;
+	hdr[11] = (uint32)dirty.h;
+	// Placement of the guest image in window space (for absolute input)
+	hdr[12] = (uint32)output_visible.x;
+	hdr[13] = (uint32)output_visible.y;
+	hdr[14] = (uint32)output_visible.w;
+	hdr[15] = (uint32)output_visible.h;
+	hdr[16] = (uint32)output_win_w;
+	hdr[17] = (uint32)output_win_h;
+	hdr[18] = (uint32)output_rotation();
+	hdr[19] = 0;
+	// Copy only the rows that changed; the rest of the mapped frame is
+	// still current from previous publishes.
+	size_t row_bytes = (size_t)host_surface->w * 4;
+	uint8 *dst = shm_map + 80 + (size_t)dirty.y * row_bytes;
+	uint8 *srcp = (uint8 *)host_surface->pixels + (size_t)dirty.y * host_surface->pitch;
+	for (int y = 0; y < dirty.h; y++) {
+		memcpy(dst, srcp, row_bytes);
+		dst += row_bytes;
+		srcp += host_surface->pitch;
+	}
+	hdr[3] = hdr[3] + 1; // sequence counter, bumped after pixels are in place
+}
