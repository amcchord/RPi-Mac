+// Consecutive present failures; if the display stack stays broken we quit
+// so systemd can restart the emulator with a fresh KMSDRM/GL setup.
+static int present_failures = 0;
+
+static void note_present_failure(void)
+{
+	present_failures++;
+	if (present_failures == 300) {
+		printf("ERROR: display pipeline wedged (300 consecutive present failures), exiting for restart\n");
+		fflush(stdout);
+		QuitEmulator();
+	}
+}
