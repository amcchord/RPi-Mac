+// Mirror the current frame into /dev/shm so the RPi-Mac web console can
+// show a live view of the Mac screen. Throttled to ~15 fps.
+// Accumulated guest-screen changes since the last successful publish,
+// so the web console can fetch partial (VNC-style) updates.
+static SDL_Rect shm_dirty_acc = { 0, 0, 0, 0 };
+
+static void screen_shm_publish(void)
+{
+	static int shm_fd = -2;
+	static uint8 *shm_map = NULL;
+	static size_t shm_size = 0;
+	static uint32 last_publish = 0;
+
+	if (host_surface == NULL)
+		return;
+	uint32 now = SDL_GetTicks();
+	if (now - last_publish < 66)
+		return;
+	last_publish = now;
+
+	size_t need = 48 + (size_t)host_surface->w * host_surface->h * 4;
+	// If something removed the file (e.g. logind RemoveIPC), start over
+	if (shm_fd >= 0) {
+		struct stat st;
+		if (stat("/dev/shm/rpimac-screen", &st) != 0) {
+			close(shm_fd);
+			shm_fd = -2;
+			if (shm_map != NULL) {
+				munmap(shm_map, shm_size);
+				shm_map = NULL;
+				shm_size = 0;
+			}
+		}
+	}
+	if (shm_fd == -2)
+		shm_fd = open("/dev/shm/rpimac-screen", O_RDWR | O_CREAT, 0644);
+	if (shm_fd < 0) {
+		shm_fd = -2; // retry next time
+		return;
+	}
+	if (shm_size != need) {
+		if (shm_map != NULL) {
+			munmap(shm_map, shm_size);
+			shm_map = NULL;
+			shm_size = 0;
+		}
+		if (ftruncate(shm_fd, need) != 0)
+			return;
+		void *m = mmap(NULL, need, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
+		if (m == MAP_FAILED)
+			return;
+		shm_map = (uint8 *)m;
+		shm_size = need;
+	}
+
+	uint32 *hdr = (uint32 *)shm_map;
+	hdr[0] = 0x52504d33; // 'RPM3'
+	hdr[1] = (uint32)host_surface->w;
+	hdr[2] = (uint32)host_surface->h;
+	// Byte offsets of R, G, B within each little-endian 32-bit pixel.
+	// Basilisk pushes host_surface bytes into the texture unconverted, so
+	// the texture format (not the surface masks, which can be wrong on
+	// little-endian hosts) describes what these bytes really mean.
+	Uint32 tex_format = SDL_PIXELFORMAT_ARGB8888;
+	if (sdl_texture != NULL)
+		SDL_QueryTexture(sdl_texture, &tex_format, NULL, NULL, NULL);
+	if (tex_format == SDL_PIXELFORMAT_BGRA8888) {
+		hdr[4] = 1; // A,R,G,B in memory
+		hdr[5] = 2;
+		hdr[6] = 3;
+	} else {
+		hdr[4] = 2; // ARGB8888: B,G,R,A in memory
+		hdr[5] = 1;
+		hdr[6] = 0;
+	}
+	hdr[7] = 0;
+	// Dirty rectangle of this publish (clamped to the surface)
+	SDL_Rect dirty = shm_dirty_acc;
+	SDL_Rect full = { 0, 0, host_surface->w, host_surface->h };
+	if (SDL_RectEmpty(&dirty)) {
+		dirty = full;
+	} else {
+		SDL_IntersectRect(&dirty, &full, &dirty);
+	}
+	hdr[8] = (uint32)dirty.x;
+	hdr[9] = (uint32)dirty.y;
+	hdr[10] = (uint32)dirty.w;
+	hdr[11] = (uint32)dirty.h;
+	uint8 *dst = shm_map + 48;
+	uint8 *srcp = (uint8 *)host_surface->pixels;
+	for (int y = 0; y < host_surface->h; y++) {
+		memcpy(dst, srcp, (size_t)host_surface->w * 4);
+		dst += (size_t)host_surface->w * 4;
+		srcp += host_surface->pitch;
+	}
+	hdr[3] = hdr[3] + 1; // sequence counter, bumped after pixels are in place
+	shm_dirty_acc.x = 0;
+	shm_dirty_acc.y = 0;
+	shm_dirty_acc.w = 0;
+	shm_dirty_acc.h = 0;
+}
