+// Map absolute window coordinates to guest screen coordinates using the
+// exact placement (rotation, scale, margin offsets) computed by the
+// renderer. Touchscreens, tablets and SDL's internal pointer for relative
+// mice all come through here.
+static void rotate_mouse_coords(int &x, int &y)
+{
+	int rot = output_rotation();
+	int off_x = 0, off_y = 0;
+	output_offsets(&off_x, &off_y);
+	if ((rot == 0 && off_x == 0 && off_y == 0) || drv == NULL)
+		return;	// logical-size path: SDL already scales coordinates
+	if (output_visible.w <= 1 || output_visible.h <= 1)
+		return;	// nothing presented yet
+	const VIDEO_MODE &mode = drv->mode;
+	double u = (double)(x - output_visible.x) / (output_visible.w - 1);
+	double v = (double)(y - output_visible.y) / (output_visible.h - 1);
+	if (u < 0.0) u = 0.0;
+	if (u > 1.0) u = 1.0;
+	if (v < 0.0) v = 0.0;
+	if (v > 1.0) v = 1.0;
+	double fx = u, fy = v;
+	if (rot == 90) {
+		fx = v;
+		fy = 1.0 - u;
+	} else if (rot == 270) {
+		fx = 1.0 - v;
+		fy = u;
+	} else if (rot == 180) {
+		fx = 1.0 - u;
+		fy = 1.0 - v;
+	}
+	x = (int)(fx * (VIDEO_MODE_X - 1));
+	y = (int)(fy * (VIDEO_MODE_Y - 1));
+}
