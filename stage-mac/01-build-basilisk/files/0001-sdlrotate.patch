+// Map absolute window coordinates to guest screen coordinates, honouring
+// the "sdlrotate" output rotation. Without this, rotated panels (and
+// anything that positions the cursor absolutely: touchscreens, tablets,
+// SDL's internal pointer for relative mice) clamp to the wrong axis and
+// land on the wrong spot.
+static void rotate_mouse_coords(int &x, int &y)
+{
+	static int rot = -1;
+	if (rot < 0)
+		rot = ((PrefsFindInt32("sdlrotate") % 360) + 360) % 360;
+	if (rot == 0 || sdl_window == NULL || drv == NULL)
+		return;
+	int win_w = 0, win_h = 0;
+	SDL_GetWindowSize(sdl_window, &win_w, &win_h);
+	if (win_w <= 1 || win_h <= 1)
+		return;
+	const VIDEO_MODE &mode = drv->mode;
+	double ax = (double)x / (win_w - 1);
+	double ay = (double)y / (win_h - 1);
+	int gx = x, gy = y;
+	if (rot == 270) {
+		gx = (int)((1.0 - ay) * (VIDEO_MODE_X - 1));
+		gy = (int)(ax * (VIDEO_MODE_Y - 1));
+	} else if (rot == 90) {
+		gx = (int)(ay * (VIDEO_MODE_X - 1));
+		gy = (int)((1.0 - ax) * (VIDEO_MODE_Y - 1));
+	} else if (rot == 180) {
+		gx = (int)((1.0 - ax) * (VIDEO_MODE_X - 1));
+		gy = (int)((1.0 - ay) * (VIDEO_MODE_Y - 1));
+	}
+	x = gx;
+	y = gy;
+}
