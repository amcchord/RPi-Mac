[Unit]
Description=pimac SD card builder worker
After=network.target

[Service]
# Root: the worker loop-mounts image partitions.
User=root
Environment=PIMAC_ROOT=/srv/pimac
ExecStart=/usr/bin/python3 /opt/pimac/builder/worker.py
Restart=on-failure
RestartSec=5
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
